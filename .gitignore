# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
.idea
env/
venv/
ENV/
env.bak/
venv.bak/

# VS Code
.vscode
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Distribution / packaging
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
*.egg-info/
*.egg

# Ruff
.ruff_cache/

# Python test / typecheck / build caches
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml

# Log files (-l/--log-file output)
*.log

# Data: a whitelist. Only the sample and the registry are tracked; data/songdo/ is fetched or
# linked. See data/README.md.
data/*
!data/README.md
!data/registry.yaml
!data/sample/
# Outputs written into the sample, and the annotation sessions a user adds to it
data/sample/**/oracle/
data/sample/**/results/
data/sample/**/plots/
data/sample/**/gcp_repeat/
data/sample/**/gcp_manual/

# Frames and labels staged by `survey` (default work directory)
survey/

# Tables and figures written by `report` (default output)
reports/

# Detector and SAM checkpoints, downloaded by hbb2obb into the working directory
/models/

# Mac OS-specific storage files
.DS_Store
**/.DS_Store

# Google Drive specific files
.tmp.driveupload
.tmp.drivedownload
